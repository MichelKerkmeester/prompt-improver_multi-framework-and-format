# OS-generated files
.DS_Store

# export/: keep the folder, its .gitkeep and the benchmark deliverables, ignore everything else
export/*
!export/.gitkeep
!export/benchmark/

# Spec folders are tracked; this overrides the global /specs ignore
!/specs/

# context/: reference material for the AI stays on this machine. The folder, .gitkeep and README.md are tracked
/context/*
!/context/.gitkeep
!/context/README.md

# specs/personal/: your own spec folders stay on this machine. The track, .gitkeep and README.md are tracked
/specs/personal/*
!/specs/personal/.gitkeep
!/specs/personal/README.md
!/specs/personal/z_archive/
/specs/personal/z_archive/*
!/specs/personal/z_archive/.gitkeep
!/specs/personal/z_archive/README.md
